---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { SITE_TITLE } from '../consts';
import { absoluteAssetWithBase, absoluteWithBase, assetWithBase, withoutBase } from '../utils/site-url';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
}

const pagePath = withoutBase(Astro.url.pathname);
const canonicalURL = absoluteWithBase(pagePath, Astro.site);

const { title, description, image = FallbackImage } = Astro.props;
const imageURL = absoluteAssetWithBase(image.src, Astro.site);
const regularFontURL = assetWithBase('/fonts/atkinson-regular.woff');
const boldFontURL = assetWithBase('/fonts/atkinson-bold.woff');
const fontFaceCSS = `
	@font-face {
		font-family: "Atkinson";
		src: url("${regularFontURL}") format("woff");
		font-weight: 400;
		font-style: normal;
		font-display: swap;
	}
	@font-face {
		font-family: "Atkinson";
		src: url("${boldFontURL}") format("woff");
		font-weight: 700;
		font-style: normal;
		font-display: swap;
	}
`;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href={assetWithBase('/favicon.svg')} />
<link rel="sitemap" href={assetWithBase('/sitemap-index.xml')} />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={absoluteWithBase('/rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Font preloads -->
<link rel="preload" href={regularFontURL} as="font" type="font/woff" crossorigin />
<link rel="preload" href={boldFontURL} as="font" type="font/woff" crossorigin />
<style set:html={fontFaceCSS} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={imageURL} />
