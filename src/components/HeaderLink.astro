---
import type { HTMLAttributes } from 'astro/types';
import { withBase, withoutBase } from '../utils/site-url';

type Props = HTMLAttributes<'a'> & { href: string };

const { href, class: className, ...props } = Astro.props;
const pathname = withoutBase(Astro.url.pathname);
const subpath = pathname.match(/[^\/]+/g);
const normalizePath = (path: string) => (path === '/' ? path : path.replace(/\/$/, ''));
const normalizedHref = normalizePath(href);
const isActive =
	normalizedHref === normalizePath(pathname) || normalizedHref === '/' + (subpath?.[0] || '');
---

<a href={withBase(href)} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
