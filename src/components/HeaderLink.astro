---
import type { HTMLAttributes } from 'astro/types';
import { withBase } from '../utils/site-url';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const normalizeRoute = (value: string) => {
	const route = value.startsWith('/') ? value : `/${value}`;
	return route === '/' ? route : route.replace(/\/+$/, '');
};
const pathname = normalizeRoute(Astro.url.pathname.replace(import.meta.env.BASE_URL, ''));
const subpath = pathname.match(/[^\/]+/g);
const normalizedHref = typeof href === 'string' ? normalizeRoute(href) : undefined;
const isActive = normalizedHref === pathname || normalizedHref === '/' + (subpath?.[0] || '');
const resolvedHref = typeof href === 'string' ? withBase(href) : href;
---

<a href={resolvedHref} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
