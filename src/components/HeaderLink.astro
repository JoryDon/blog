---
import type { HTMLAttributes } from 'astro/types';
import { withBase, withoutBase } from '../utils/site-url';

interface Props extends HTMLAttributes<'a'> {
	href: string;
}

const { href, class: className, ...props } = Astro.props;
const normalizePath = (path: string) => {
	const normalizedPath = withoutBase(path);

	return normalizedPath === '/' ? normalizedPath : normalizedPath.replace(/\/$/, '');
};
const pathname = normalizePath(Astro.url.pathname);
const subpath = pathname.match(/[^\/]+/g);
const hrefPath = normalizePath(href);
const isActive = hrefPath === pathname || hrefPath === '/' + (subpath?.[0] || '');
---

<a href={withBase(href)} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
