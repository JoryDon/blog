---
import type { HTMLAttributes } from 'astro/types';
import { withBase, withoutBase } from '../utils/site-url';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const hrefString = typeof href === 'string' ? href : '/';
const normalizeForMatch = (path: string) => {
	const normalizedPath = withoutBase(path);
	return normalizedPath !== '/' && normalizedPath.endsWith('/')
		? normalizedPath.slice(0, -1)
		: normalizedPath;
};
const pathname = normalizeForMatch(Astro.url.pathname);
const targetPath = normalizeForMatch(hrefString);
const isActive =
	targetPath === pathname || (targetPath !== '/' && pathname.startsWith(`${targetPath}/`));
---

<a href={withBase(hrefString)} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
