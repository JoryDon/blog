---
import type { HTMLAttributes } from 'astro/types';
import { withBase, withoutBase } from '../utils/site-url';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;

function normalizeRoute(path: string) {
	const normalized = withoutBase(path).replace(/\/$/, '');
	return normalized || '/';
}

const pathname = normalizeRoute(Astro.url.pathname);
const hrefPath = typeof href === 'string' ? normalizeRoute(href) : '';
const isActive =
	hrefPath === pathname || (hrefPath !== '/' && pathname.startsWith(`${hrefPath}/`));
const renderedHref = typeof href === 'string' ? withBase(href) : href;
---

<a href={renderedHref} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
