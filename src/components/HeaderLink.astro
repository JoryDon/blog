---
import type { HTMLAttributes } from 'astro/types';
import { withBase, withoutBase } from '../utils/urls';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const pathname = withoutBase(Astro.url.pathname);
const linkPath = typeof href === 'string' ? withoutBase(href) : '';
const subpath = pathname.match(/[^\/]+/g);
const isActive = linkPath === pathname || linkPath === '/' + (subpath?.[0] || '');
const resolvedHref = typeof href === 'string' ? withBase(href) : href;
---

<a href={resolvedHref} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
