---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const normalize = (path: string) => (path.endsWith('/') ? path : `${path}/`);
const stripBase = (path: string) => normalize(`/${path.replace(import.meta.env.BASE_URL, '').replace(/^\/+/, '')}`);
const pathname = stripBase(Astro.url.pathname);
const subpath = pathname.match(/[^\/]+/g);
const targetPath = typeof href === 'string' ? stripBase(href) : '';
const isActive = targetPath === pathname || targetPath === `/${subpath?.[0] || ''}/`;
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
