---
import type { HTMLAttributes } from 'astro/types';
import { withBase, withoutBase } from '../utils/site-url';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const normalizedHref = href?.toString() || '';
const pathname = withoutBase(Astro.url.pathname);
const subpath = pathname.match(/[^\/]+/g);
const isActive = normalizedHref === pathname || normalizedHref === '/' + (subpath?.[0] || '');
---

<a href={withBase(normalizedHref)} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
