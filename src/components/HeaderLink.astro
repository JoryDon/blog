---
import type { HTMLAttributes } from 'astro/types';
import { withBase, withoutBase } from '../utils/site-url';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const normalizePath = (path: string | undefined) => {
	const pathname = (path || '/').split(/[?#]/)[0].replace(/^\/+|\/+$/g, '');
	return pathname ? `/${pathname}` : '/';
};
const pathname = normalizePath(withoutBase(Astro.url.pathname));
const normalizedHref = normalizePath(href);
const subpath = pathname.match(/[^\/]+/g);
const isActive = normalizedHref === pathname || normalizedHref === '/' + (subpath?.[0] || '');
const renderedHref = href ? withBase(href) : href;
---

<a href={renderedHref} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
