---
import type { HTMLAttributes } from 'astro/types';
import { stripBase } from '../utils/site-url';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const normalize = (path: string | URL | undefined) => {
	const normalized = stripBase(String(path ?? '/')).replace(/\/$/, '');
	return normalized || '/';
};
const pathname = normalize(Astro.url.pathname);
const hrefPath = normalize(href);
const subpath = pathname.match(/[^\/]+/g);
const isActive = hrefPath === pathname || hrefPath === '/' + (subpath?.[0] || '');
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
